* text=auto

# Scripts para Unix / macOS (siempre LF)
*.sh text eol=lf
*.command text eol=lf
*.py text eol=lf

# Scripts para Windows (siempre CRLF)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Archivos de texto y configuracion (siempre LF para consistencia multiplataforma)
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
